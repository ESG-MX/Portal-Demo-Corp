{
  "name": "portal-democorp",
  "version": "1.0.0",
  "description": "Portal Demo Corp - Sistema de gestión de servicios de cafetería",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server/index.js",
    "install-all": "npm install && cd client && npm install && cd ../server && npm install",
    "dev:server": "cd server && npx nodemon index.js",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build:local": "cd client && npm run build"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1",
    "@azure/keyvault-secrets": "^4.11.2",
    "@azure/storage-blob": "^12.31.0",
    "archiver": "^7.0.1",
    "axios": "^1.6.2",
    "cors": "^2.8.5",
    "csv-parser": "^3.2.0",
    "dotenv": "^16.6.1",
    "express": "^4.18.2",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.2",
    "mssql": "^10.0.1",
    "multer": "^2.1.1",
    "node-cron": "^4.2.1",
    "puppeteer": "^24.40.0",
    "tedious": "^16.4.1",
    "uuid": "^8.3.2",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "nodemon": "^3.0.1"
  },
  "author": "",
  "license": "ISC"
}
