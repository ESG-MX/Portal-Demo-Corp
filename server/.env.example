# Copy this file to .env and fill in your own values.

# --- Demo mode ---
USE_MOCK_DB=true          # true = in-memory mock data, false = real Azure SQL
DEMO_MODE=true            # true = bypass Azure AD auth, false = require real tokens
NODE_ENV=development
PORT=8080
DEMO_ADMIN_EMAIL=admin@yourcompany.com

# --- Azure SQL ---
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_SERVER=your-server.database.windows.net
DB_NAME=your_database_name

# --- SAP Business One Service Layer ---
SAP_BASE_URL=https://your-sap-host:50000/b1s/v1/
SAP_COMPANY_DB=YourCompanyDB
SAP_USER=your_sap_user
SAP_PASSWORD=your_sap_password

# --- Azure AD (Entra ID) ---
AZURE_TENANT_ID=your-tenant-id
AZURE_CLIENT_ID=your-client-id
AZURE_CLIENT_SECRET=your-client-secret

# --- Azure Blob Storage ---
AZURE_STORAGE_CONNECTION_STRING=your-connection-string
AZURE_STORAGE_CONTAINER_NAME=your-container

# --- SAP Encryption ---
SAP_ENCRYPT_KEY_LOCAL=your-32-char-local-key-for-dev!!
KEY_VAULT_NAME=your-keyvault-name
